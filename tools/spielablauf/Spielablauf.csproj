<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stellt Abläufe aus RTSGameplayScreen ohne Grafik nach und prüft sie: wer
    baut, wer stehen bleibt, was ein Klick bewirkt. Die Unit-Tests sehen nur
    AoE.Core, die Kartenprüfung nur den Kartengenerator. Aufruf siehe Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgeOfEmpiresClone\AgeOfEmpiresClone.Core\AgeOfEmpiresClone.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

</Project>
