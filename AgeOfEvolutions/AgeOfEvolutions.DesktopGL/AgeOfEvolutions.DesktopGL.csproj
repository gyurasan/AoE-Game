<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../AgeOfEvolutions.Core/Content/Icon.ico</ApplicationIcon>
    <AssemblyName>AgeOfEvolutions</AssemblyName>
    <AssemblyTitle>AgeOfEvolutions</AssemblyTitle>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fenstersymbol: MonoGame sucht die Ressource Icon.bmp, sonst zeigt es sein eigenes Logo -->
    <EmbeddedResource Include="../AgeOfEvolutions.Core/Content/Icon.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\AgeOfEvolutions.Core\Content\AgeOfEvolutions.mgcb">
      <Link>Content\AgeOfEvolutions.mgcb</Link>
    </MonoGameContentReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgeOfEvolutions.Core\AgeOfEvolutions.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <!--
    Die Shader in Content/Effects übersetzt MonoGame auf macOS sonst nur mit Wine. Hier
    nimmt der Content Builder stattdessen tools/shaderc: vkd3d-compiler, nativ gebaut
    (einmalig tools/shaderc/build.sh), hinter einem Ersatz für wine.
  -->
  <Target Name="NativeShaderCompiler" BeforeTargets="RunContentBuilder" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <ShadercDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'tools', 'shaderc'))</ShadercDir>
      <_Command>PATH=&quot;$(ShadercDir):$PATH&quot; MGFXC_WINE_PATH=&quot;$(ShadercDir)&quot; &quot;$(DotnetCommand)&quot; &quot;$(MGCBCommand)&quot;</_Command>
    </PropertyGroup>
    <Error Condition="!Exists('$(ShadercDir)bin/vkd3d-compiler')" Text="Shader-Compiler fehlt: einmalig tools/shaderc/build.sh ausführen." />
  </Target>
</Project>