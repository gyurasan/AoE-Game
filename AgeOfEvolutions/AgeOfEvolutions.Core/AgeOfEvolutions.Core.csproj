<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <!-- Nullable: AoE.Core Interfaces (IWorldState) erlauben null z. B. bei
         TownCenter — die Annotationen dürfen aber nicht gegen CS8632 laufen. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-Typen: Native ist eine verwaltete, plattformneutrale
         MonoGame.Framework.dll (netstandard2.1) mit allen Microsoft.Xna.Framework.*-
         Typen, auch SoundEffect. PrivateAssets=All hält sie aus den Apps heraus;
         die bringen ihre Plattform-MonoGame (WindowsDX bzw. DesktopGL) selbst mit.
         Hier KEIN zweites Plattform-Paket referenzieren: Ohne PrivateAssets landet
         dessen MonoGame.Framework.dll auch in der DX-App, und die bricht über
         "effect built for a different platform". Version: Directory.Build.props. -->
    <PackageReference Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AoE.Core\AoE.Core.csproj" />
  </ItemGroup>
</Project>
