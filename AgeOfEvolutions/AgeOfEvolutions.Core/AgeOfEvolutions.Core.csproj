<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <!-- Nullable: AoE.Core Interfaces (IWorldState) erlauben null z. B. bei
         TownCenter — die Annotationen dürfen aber nicht gegen CS8632 laufen. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Laufzeit-Natives (PrivateAssets=All: fließen nicht an Apps weiter —
         die Apps referenzieren ihre Plattform-Pakete selbst). -->
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.*">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <!-- Kompilier-Zeittypen: Microsoft.Xna.Framework.* (u.a. SoundEffect aus
         Microsoft.Xna.Framework.Audio) steckt NICHT im Native-Paket, sondern
         im Plattform-/Managed-Paket. Ohne diese Referenz bricht Rider beim
         isolierten Kompilieren dieses Projekts über "SoundEffect nicht gefunden".
         ExcludeAssets=runtime;content: NUR Compile-Referenz, die Assembly wird
         NICHT in die App-Outputs kopiert — sonst landet die DesktopGL-MonoGame
         auch im WindowsDX-Publish (Assembly-Konflikt MonoGame.Framework.dll) und
         die DirectX-Version bricht über "effect built for a different platform". -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime;content</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AoE.Core\AoE.Core.csproj" />
  </ItemGroup>
</Project>
